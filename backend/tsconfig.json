{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./dist",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "types": ["node", "jest"],
        "typeRoots": ["./node_modules/@types", "./src/types"],
        "isolatedModules": true,
        "declaration": false,
        "removeComments": true
    },
    "include": ["src/**/*", "tests", "generated/prisma", "test"],
    "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
    "ts-node": {
        "esm": true
    }
}
